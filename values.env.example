# Beispiel für /etc/proxy-config/values.env
#
# Diese Datei ist KEIN Repo-Inhalt im Sinne von "wird auf VMs deployed".
# Die echte values.env liegt auf jeder VM unter /etc/proxy-config/values.env
# und wird NICHT ins Repo gepusht.
#
# Diese .example-Datei dokumentiert nur, welche Variablen erwartet werden.

# === Allgemein ===
NODE_ROLE=MASTER                    # MASTER oder BACKUP
NODE_NAME=proxy01
PEER_NAME=proxy02
PEER_TAILSCALE_IP=100.x.x.x         # Tailscale-IP des Peers (für Cert-Sync)

# === keepalived ===
VRRP_INTERFACE=eth0
VRRP_VIRTUAL_ROUTER_ID=51
VRRP_PRIORITY=100                   # MASTER=100, BACKUP=90
VRRP_AUTH_PASS=ein-shared-secret    # zwischen den Nodes identisch
FLOATING_IP=192.168.1.100/24

# === Tailscale ===
TAILSCALE_AUTHKEY=tskey-auth-...    # nur für initiales Setup
STATUS_BIND_IP=100.x.x.x            # Tailscale-IP dieser Node

# === ACME / Let's Encrypt ===
ACME_EMAIL=admin@example.com

# === Services ===
# Hier pro Service ein Block — verwendet von den .conf.template-Dateien
SERVICE1_DOMAIN=service1.example.com
SERVICE1_BACKEND=10.0.5.50:3000

SERVICE2_DOMAIN=service2.example.com
SERVICE2_BACKEND=10.0.5.51:8080

# ... weitere Services
