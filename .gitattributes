# Alles, was auf Linux-VMs landet, MUSS LF haben.
# CRLF in Bash-Scripts → "/bin/bash^M: bad interpreter"-Fehler.
# CRLF in nginx/keepalived/systemd-Configs → schwer zu debuggende Parse-Fehler.

*.sh        text eol=lf
*.py        text eol=lf
*.conf      text eol=lf
*.service   text eol=lf
*.timer     text eol=lf
*.snippet   text eol=lf
*.html      text eol=lf
*.css       text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
*.env       text eol=lf
*.example   text eol=lf
Makefile    text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# Binärdateien explizit markieren
*.pem       binary
*.key       binary
*.crt       binary
*.png       binary
*.jpg       binary
*.ico       binary
