# Alles, was auf der Linux-VM landet, MUSS LF haben.
# CRLF in Bash-Scripts → "/bin/bash^M: bad interpreter"-Fehler.

*.sh        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.md        text eol=lf
*.txt       text eol=lf
.gitignore  text eol=lf
.gitattributes text eol=lf

# Binärdateien explizit markieren
*.png       binary
*.jpg       binary
*.ico       binary
